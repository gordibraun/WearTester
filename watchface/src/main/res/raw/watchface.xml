<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#000000">
        <Group name="static_text" x="0" y="0" width="450" height="450">
            <DigitalClock x="0" y="52" width="450" height="88">
                <TimeText x="0" y="0" width="450" height="88" format="hh:mm">
                    <Font family="SYNC_TO_DEVICE" size="74" color="#FFFFFF" />
                </TimeText>
            </DigitalClock>

            <PartText x="0" y="142" width="450" height="34" alpha="255">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="24" color="#4DD0E1">
                        <![CDATA[Dexcom Live]]>
                    </Font>
                </Text>
            </PartText>

            <PartText x="0" y="362" width="450" height="34" alpha="255">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="24" color="#4DD0E1">
                        <![CDATA[mg/dL]]>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <ComplicationSlot
            slotId="0"
            x="70"
            y="190"
            width="310"
            height="145"
            name="glucose"
            displayName="@string/glucose_slot_name"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <BoundingOval x="0" y="0" width="310" height="145" />
            <DefaultProviderPolicy
                primaryProvider="com.example.weartester/com.example.weartester.DexcomGlucoseComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <Group name="glucose_value" x="0" y="0" width="310" height="145">
                    <PartText x="0" y="0" width="310" height="98" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" color="#7CFF7C">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="102" width="310" height="34" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="26" color="#B0BEC5">
                                <Template><![CDATA[%s ago]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>

            <Complication type="EMPTY">
                <Group name="glucose_empty" x="0" y="0" width="310" height="145">
                    <PartText x="0" y="8" width="310" height="90" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="86" weight="BOLD" color="#90A4AE">
                                <![CDATA[--]]>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="102" width="310" height="34" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="26" color="#B0BEC5">
                                <![CDATA[waiting Dexcom]]>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
