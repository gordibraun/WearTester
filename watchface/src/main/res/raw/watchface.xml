<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#000000">
        <Group name="static_text" x="0" y="0" width="450" height="450">
            <DigitalClock x="0" y="18" width="450" height="76">
                <TimeText x="0" y="0" width="450" height="76" format="hh:mm">
                    <Font family="SYNC_TO_DEVICE" size="66" color="#FFFFFF" />
                </TimeText>
            </DigitalClock>

        </Group>

        <ComplicationSlot
            slotId="0"
            x="70"
            y="118"
            width="310"
            height="118"
            name="glucose"
            displayName="@string/glucose_slot_name"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <BoundingOval x="0" y="0" width="310" height="118" />
            <DefaultProviderPolicy
                primaryProvider="com.example.weartester/com.example.weartester.DexcomGlucoseComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <Group name="glucose_value" x="0" y="0" width="310" height="118">
                    <PartText x="0" y="0" width="310" height="90" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="#7CFF7C">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="90" width="310" height="28" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="24" color="#B0BEC5">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>

            <Complication type="EMPTY">
                <Group name="glucose_empty" x="0" y="0" width="310" height="118">
                    <PartText x="0" y="4" width="310" height="86" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="86" weight="BOLD" color="#90A4AE">
                                <![CDATA[--]]>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="90" width="310" height="28" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="24" color="#B0BEC5">
                                <![CDATA[waiting Dexcom]]>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="1" x="50" y="94" width="350" height="28"
            name="sensor_expiry" displayName="@string/sensor_expiry_slot_name"
            supportedTypes="LONG_TEXT EMPTY" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="350" height="28" />
            <DefaultProviderPolicy primaryProvider="com.example.weartester/com.example.weartester.SensorExpiryComplicationService"
                primaryProviderType="LONG_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="LONG_TEXT">
                <Condition>
                    <Expressions><Expression name="urgent"><![CDATA[[COMPLICATION.TITLE] == "!"]]></Expression></Expressions>
                    <Compare expression="urgent">
                        <PartText x="0" y="0" width="350" height="28">
                            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FFB74D">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font></Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="0" width="350" height="28">
                            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font></Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="350" height="28">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">Срок сенсора неизвестен</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- The graph from the pump controller: the last hour of readings, the three-hour forecast, insulin on board, the trend. -->
        <ComplicationSlot slotId="2" x="55" y="238" width="340" height="86"
            name="graph" displayName="@string/graph_slot_name"
            supportedTypes="SMALL_IMAGE EMPTY" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="340" height="86" />
            <DefaultProviderPolicy primaryProvider="app.aaps.combobench.manual/app.aaps.combobench.controller.GraphComplicationService"
                primaryProviderType="SMALL_IMAGE" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="340" height="86">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="28" width="340" height="30">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#4DD0E1">график —</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- The pump now: temporary basal and the minutes it has left, or the profile basal. -->
        <ComplicationSlot slotId="3" x="55" y="326" width="160" height="46"
            name="pump" displayName="@string/pump_slot_name"
            supportedTypes="SHORT_TEXT EMPTY" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="160" height="46" />
            <DefaultProviderPolicy primaryProvider="app.aaps.combobench.manual/app.aaps.combobench.controller.PumpComplicationService"
                primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="160" height="28">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#FFFFFF">
                        <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                    </Font></Text>
                </PartText>
                <PartText x="0" y="28" width="160" height="18">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#9AA5AE">
                        <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                    </Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="8" width="160" height="30">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">помпа —</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- The link: who commands ("помпа ✓" with the phone, "часы ✓" when the watch is on its own) over how long since the phone was heard ("тел 2м"). -->
        <ComplicationSlot slotId="4" x="235" y="326" width="160" height="46"
            name="link" displayName="@string/link_slot_name"
            supportedTypes="SHORT_TEXT EMPTY" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="160" height="46" />
            <DefaultProviderPolicy primaryProvider="app.aaps.combobench.manual/app.aaps.combobench.controller.LinkComplicationService"
                primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="160" height="28">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#FFFFFF">
                        <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                    </Font></Text>
                </PartText>
                <PartText x="0" y="28" width="160" height="18">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#9AA5AE">
                        <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                    </Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="8" width="160" height="30">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">связь —</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <Group name="carbs_shortcut" x="130" y="376" width="92" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="92" height="50">
                <RoundRectangle x="0" y="0" width="92" height="50" cornerRadiusX="8" cornerRadiusY="8">
                    <Fill color="#181818" />
                </RoundRectangle>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartDraw>
            <PartImage x="34" y="2" width="24" height="24" tintColor="#FFB74D">
                <Image resource="ic_wheat" />
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartImage>
            <PartText x="0" y="27" width="92" height="20">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#FFB74D">Углеводы</Font></Text>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartText>
        </Group>
        <Group name="activity_shortcut" x="228" y="376" width="92" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="92" height="50">
                <RoundRectangle x="0" y="0" width="92" height="50" cornerRadiusX="8" cornerRadiusY="8">
                    <Fill color="#181818" />
                </RoundRectangle>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartDraw>
            <PartImage x="34" y="2" width="24" height="24" tintColor="#4DD0E1">
                <Image resource="ic_footprints" />
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartImage>
            <PartText x="0" y="27" width="92" height="20">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#4DD0E1">Нагрузка</Font></Text>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartText>
        </Group>
    </Scene>
</WatchFace>
