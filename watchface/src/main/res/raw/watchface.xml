<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#000000">
        <Group name="static_text" x="0" y="0" width="450" height="450">
            <DigitalClock x="0" y="28" width="450" height="80">
                <TimeText x="0" y="0" width="450" height="80" format="hh:mm">
                    <Font family="SYNC_TO_DEVICE" size="66" color="#FFFFFF" />
                </TimeText>
            </DigitalClock>

            <PartText x="0" y="277" width="450" height="26" alpha="255">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" color="#4DD0E1">
                        <![CDATA[mg/dL]]>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <ComplicationSlot
            slotId="0"
            x="70"
            y="142"
            width="310"
            height="132"
            name="glucose"
            displayName="@string/glucose_slot_name"
            supportedTypes="SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <BoundingOval x="0" y="0" width="310" height="132" />
            <DefaultProviderPolicy
                primaryProvider="com.example.weartester/com.example.weartester.DexcomGlucoseComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <Group name="glucose_value" x="0" y="0" width="310" height="132">
                    <PartText x="0" y="0" width="310" height="98" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" color="#7CFF7C">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="102" width="310" height="30" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="26" color="#B0BEC5">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>

            <Complication type="EMPTY">
                <Group name="glucose_empty" x="0" y="0" width="310" height="132">
                    <PartText x="0" y="8" width="310" height="90" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="86" weight="BOLD" color="#90A4AE">
                                <![CDATA[--]]>
                            </Font>
                        </Text>
                    </PartText>

                    <PartText x="0" y="102" width="310" height="30" alpha="255">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="26" color="#B0BEC5">
                                <![CDATA[waiting Dexcom]]>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="1" x="50" y="110" width="350" height="28"
            name="sensor_expiry" displayName="@string/sensor_expiry_slot_name"
            supportedTypes="LONG_TEXT EMPTY" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="350" height="28" />
            <DefaultProviderPolicy primaryProvider="com.example.weartester/com.example.weartester.SensorExpiryComplicationService"
                primaryProviderType="LONG_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="LONG_TEXT">
                <Condition>
                    <Expressions><Expression name="urgent"><![CDATA[[COMPLICATION.TITLE] == "!"]]></Expression></Expressions>
                    <Compare expression="urgent">
                        <PartText x="0" y="0" width="350" height="28">
                            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FFB74D">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font></Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="0" width="350" height="28">
                            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">
                                <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Font></Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="350" height="28">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" color="#9AA5AE">Срок сенсора неизвестен</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <Group name="carbs_shortcut" x="80" y="310" width="135" height="82">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="135" height="82">
                <RoundRectangle x="0" y="0" width="135" height="82" cornerRadiusX="8" cornerRadiusY="8">
                    <Fill color="#181818" />
                </RoundRectangle>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartDraw>
            <PartImage x="48" y="8" width="40" height="40" tintColor="#FFB74D">
                <Image resource="ic_wheat" />
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartImage>
            <PartText x="0" y="52" width="135" height="26">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="22" color="#FFB74D">Углеводы</Font></Text>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchCarbsShortcut" />
            </PartText>
        </Group>
        <Group name="activity_shortcut" x="235" y="310" width="135" height="82">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="135" height="82">
                <RoundRectangle x="0" y="0" width="135" height="82" cornerRadiusX="8" cornerRadiusY="8">
                    <Fill color="#181818" />
                </RoundRectangle>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartDraw>
            <PartImage x="48" y="8" width="40" height="40" tintColor="#4DD0E1">
                <Image resource="ic_footprints" />
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartImage>
            <PartText x="0" y="52" width="135" height="26">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="22" color="#4DD0E1">Нагрузка</Font></Text>
                <Launch target="info.nightscout.androidaps/app.aaps.wear.interaction.actions.WatchActivityShortcut" />
            </PartText>
        </Group>
    </Scene>
</WatchFace>
